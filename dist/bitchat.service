# Installed by omarchy-bitchat (https://github.com/derekross/omarchy-bitchat);
# install.sh and uninstall.sh only replace or remove this file while this line is here.
[Unit]
Description=bitchat Bluetooth mesh node for the Omarchy bar
Documentation=https://github.com/derekross/omarchy-bitchat
PartOf=graphical-session.target
After=graphical-session.target bluetooth.target

[Service]
Type=simple
ExecStart=%h/.local/bin/bitchatd
# Fixed paths, so they always match ReadWritePaths below whatever XDG says.
Environment=BITCHAT_DATA_DIR=%h/.local/share/omarchy-bitchat
Environment=BITCHAT_STATE_DIR=%h/.local/state/omarchy-bitchat
Restart=on-failure
RestartSec=3

# Hardening. The daemon needs: its data and state dirs, the runtime dir for
# its socket, and the system bus (BlueZ). Bluetooth itself goes through
# bluetoothd, so no Bluetooth sockets or capabilities are needed here.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/share/omarchy-bitchat -%h/.local/state/omarchy-bitchat %t
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
# The identity keys live in this process: never write core dumps.
LimitCORE=0
UMask=0077

[Install]
WantedBy=graphical-session.target
